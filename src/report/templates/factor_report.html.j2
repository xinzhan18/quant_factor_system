    <div class="composite-summary">
        <div class="composite-grade-large">{{ scores.composite.grade }}</div>
        <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:1.8em; font-weight:700; color:#e6edf3;">{{ "%.1f" | format(scores.composite.score or 0) }} / 100</div>
