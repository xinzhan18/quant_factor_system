    {% endif %}

    <div class="score-table-container">
        <!-- Radar Chart -->
        <div class="chart-container" style="margin-bottom:0;">
            {% if scores and scores.charts and scores.charts.radar %}
                {{ scores.charts.radar | safe }}
            {% else %}
                <div class="chart-unavailable">Radar chart unavailable</div>
            {% endif %}
        </div>

        <!-- Score Dimension Table -->
        {% if scores and scores.dimensions and scores.dimensions | length > 0 %}
        <div>
            <table class="score-dim-table">
                <thead>
                    <tr>
                        <th>维度</th>
                        <th>得分</th>
                        <th>评级</th>
                    </tr>
                </thead>
                <tbody>
                    {% for dim in scores.dimensions %}
                    <tr>
                        <td>{{ dim.name }}</td>
                        <td>
                            <div class="score-bar-wrapper">
                                <div class="score-bar {% if (dim.score or 0) >= 70 %}high{% elif (dim.score or 0) >= 45 %}medium{% else %}low{% endif %}"
                                     style="width: {{ [(dim.score or 0) * 1.2, 100] | min }}px">
                                </div>
                                <span style="font-family:'JetBrains Mono',monospace; font-size:0.9em;">{{ "%.1f" | format(dim.score or 0) }}</span>
                            </div>
                        </td>
                        <td style="font-family:'JetBrains Mono',monospace; font-weight:600; color: {% if dim.grade in ['A','A-'] %}var(--positive){% elif dim.grade in ['B+','B','B-'] %}var(--warning){% else %}var(--negative){% endif %};">
                            {{ dim.grade }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <!-- Narrative -->
    {% if narrative and narrative.section_interpretations and narrative.section_interpretations.composite %}
    <div class="narrative-box">
        <div class="llm-prefix">LLM 解读:</div>
        <p>{{ narrative.section_interpretations.composite }}</p>
    </div>
    {% endif %}
</div>

<!-- ===== Section 8: Critical Review ===== -->
<div class="section section-8">
    <div class="section-header">
        <span class="section-number">08</span>
        <span class="section-title-cn">批判性审查</span>
        <span class="section-title-en">Critical Review</span>
    </div>

    {% if narrative and narrative.critical_review %}
    <div class="critical-review-section">
        {% if narrative.critical_review.one_liner %}
        <div class="narrative-box" style="background:rgba(248,81,73,0.05); border-left-color:var(--negative); margin-bottom:12px;">
            <div class="llm-prefix" style="color:var(--negative);">一句话总结:</div>
            <p><strong>{{ narrative.critical_review.one_liner }}</strong></p>
        </div>
        {% endif %}
        {% if narrative.critical_review.body %}
        <div class="narrative-box" style="border-left-color:var(--negative); margin-bottom:16px;">
            <div class="llm-prefix" style="color:var(--negative);">LLM 解读:</div>
            <p>{{ narrative.critical_review.body }}</p>
        </div>
        {% elif narrative.critical_review.overall_assessment %}
        <div class="narrative-box" style="border-left-color:var(--negative); margin-bottom:16px;">
            <div class="llm-prefix" style="color:var(--negative);">LLM 解读:</div>
            <p>{{ narrative.critical_review.overall_assessment }}</p>
        </div>
        {% endif %}

        <!-- Key Weaknesses Grid -->
        {% if narrative.critical_review.key_weaknesses and narrative.critical_review.key_weaknesses | length > 0 %}
        <h3 style="color:var(--negative); margin-bottom:12px; font-size:0.95em;">核心弱点 Key Weaknesses</h3>
        <div class="weakness-grid">
            {% for w in narrative.critical_review.key_weaknesses %}
            <div class="weakness-card">
                <h3>
                    {% if w.title %}{{ w.title }}{% else %}弱点 {{ loop.index }}{% endif %}
                </h3>
                <p>{% if w.detail %}{{ w.detail }}{% elif w.description %}{{ w.description }}{% else %}{{ w }}{% endif %}</p>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <!-- Improvement Directions -->
    {% if narrative.critical_review.improvement_directions and narrative.critical_review.improvement_directions | length > 0 %}
    <div class="improvement-box">
        <h3>改进方向 Improvement Directions</h3>
        <ul>
            {% for item in narrative.critical_review.improvement_directions %}
            <li>
                {% if item is mapping and item.description %}{{ item.description }}{% else %}{{ item }}{% endif %}
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    {% else %}
    <p class="missing-narrative">Narrative not generated</p>
    {% endif %}
</div>

</div><!-- .container -->

<!-- ===== Footer ===== -->
<div class="report-footer">
    <p>
        Factor Report &mdash; <strong style="color:var(--text-muted);">{{ factor.name }}</strong> (factor_{{ factor.id }}) &mdash;
        Generated at {{ generated_at }}
    </p>
    <p style="margin-top:4px;">
        Powered by Ralph Factor Mining System &middot; Quant Factor Library
    </p>
</div>

<!-- ===== Plotly Dark Theme Restyling ===== -->
<script>
(function() {
    var darkLayout = {
        paper_bgcolor: 'transparent',
        plot_bgcolor: '#161b22',
        font: { color: '#c9d1d9', family: 'IBM Plex Sans, system-ui, sans-serif', size: 12 },
        xaxis: {
            gridcolor: '#21262d',
            linecolor: '#30363d',
            zerolinecolor: '#30363d',
            tickfont: { color: '#8b949e', family: 'JetBrains Mono, monospace', size: 11 },
            title: { font: { color: '#8b949e' } }
        },
        yaxis: {
            gridcolor: '#21262d',
            linecolor: '#30363d',
            zerolinecolor: '#30363d',
            tickfont: { color: '#8b949e', family: 'JetBrains Mono, monospace', size: 11 },
            title: { font: { color: '#8b949e' } }
        },
        legend: {
            bgcolor: 'transparent',
            font: { color: '#8b949e', size: 11 }
        },
        coloraxis: {
            colorbar: {
                tickfont: { color: '#8b949e' },
                title: { font: { color: '#8b949e' } }
            }
        },
        margin: { t: 40 }
    };

    var darkColors = ['#58a6ff', '#3fb950', '#f85149', '#d29922', '#bc8cff', '#f0883e', '#39d353', '#db61a2'];

    function applyDarkTheme() {
        var plots = document.querySelectorAll('.js-plotly-plot');
        plots.forEach(function(plot, idx) {
            if (!plot.data) return;
            try {
                var layoutUpdate = JSON.parse(JSON.stringify(darkLayout));

                // Handle radial/polar axes
                if (plot.layout && plot.layout.polar) {
                    layoutUpdate.polar = {
                        bgcolor: '#161b22',
                        radialaxis: { gridcolor: '#21262d', linecolor: '#30363d', tickfont: { color: '#8b949e' } },
                        angularaxis: { gridcolor: '#21262d', linecolor: '#30363d', tickfont: { color: '#8b949e' } }
                    };
                }

                // Handle multiple y-axes
                for (var key in plot.layout) {
                    if (key.match(/^[xy]axis\d+$/)) {
                        layoutUpdate[key] = {
                            gridcolor: '#21262d',
                            linecolor: '#30363d',
                            zerolinecolor: '#30363d',
                            tickfont: { color: '#8b949e', family: 'JetBrains Mono, monospace', size: 11 },
                            title: { font: { color: '#8b949e' } }
                        };
                    }
                }

                // Restyle trace colors
                var traceUpdates = [];
                plot.data.forEach(function(trace, i) {
                    var update = {};
                    var color = darkColors[i % darkColors.length];

                    if (trace.type === 'scatter' || trace.type === 'scattergl') {
                        if (trace.line) update['line.color'] = color;
                        if (trace.marker) update['marker.color'] = color;
                    } else if (trace.type === 'bar') {
                        update['marker.color'] = color;
                        update['marker.line'] = { color: 'transparent', width: 0 };
                    } else if (trace.type === 'heatmap') {
                        update.colorscale = [
                            [0, '#f85149'],
                            [0.25, '#30363d'],
                            [0.5, '#161b22'],
                            [0.75, '#1a3a2a'],
                            [1, '#3fb950']
                        ];
                    } else if (trace.type === 'scatterpolar') {
                        update['line.color'] = '#58a6ff';
                        update['fillcolor'] = 'rgba(88,166,255,0.15)';
                    } else if (trace.type === 'histogram') {
                        update['marker.color'] = color;
                        update['marker.line'] = { color: '#30363d', width: 1 };
                    }
                    traceUpdates.push(update);
                });

                Plotly.relayout(plot, layoutUpdate);
                traceUpdates.forEach(function(update, i) {
                    if (Object.keys(update).length > 0) {
                        Plotly.restyle(plot, update, [i]);
                    }
                });
            } catch(e) {
                // Silently skip charts that fail to restyle
            }
        });
    }

    // Run after page load to ensure all Plotly charts are rendered
    if (document.readyState === 'complete') {
        applyDarkTheme();
    } else {
        window.addEventListener('load', applyDarkTheme);
    }
})();
</script>

</body>
</html>
