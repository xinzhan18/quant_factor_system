<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Factor Report: {{ factor.name }}</title>
    <script src="https://cdn.plot.ly/plotly-basic-2.35.2.min.js"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <style>
        /* ===== Base & Typography ===== */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: Georgia, 'Noto Serif SC', serif;
            font-size: 14px;
            line-height: 1.7;
            color: #2c3e50;
            background: #fafafa;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px 48px;
        }

        h1 { font-size: 1.9em; font-weight: 700; }
        h2 { font-size: 1.4em; font-weight: 600; }
        h3 { font-size: 1.1em; font-weight: 600; }

        code, .formula-inline {
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.9em;
            background: #f0f0f0;
            padding: 2px 6px;
            border-radius: 3px;
        }

        /* ===== Report Header ===== */
        .report-header {
            background: linear-gradient(135deg, #1a2a4a 0%, #2c3e6a 100%);
            color: #fff;
            padding: 36px 40px 28px;
            margin-bottom: 0;
        }

        .report-header .factor-label {
            font-size: 0.75em;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #aab8d0;
            margin-bottom: 6px;
        }

        .report-header h1 {
            font-size: 2em;
            color: #fff;
            margin-bottom: 4px;
        }

        .report-header .factor-name-en {
            font-size: 1.1em;
            color: #aab8d0;
            font-style: italic;
            margin-bottom: 16px;
        }

        .factor-meta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            font-size: 0.85em;
            color: #c8d6e8;
            margin-bottom: 18px;
        }

        .factor-meta-row span strong {
            color: #fff;
            margin-right: 4px;
        }

        .formula-box {
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 6px;
            padding: 14px 20px;
            font-family: 'Courier New', monospace;
            font-size: 0.95em;
            color: #e0eaff;
            margin-top: 10px;
            overflow-x: auto;
        }

        .formula-box .formula-raw {
            font-size: 0.85em;
            color: #8aa3c0;
            margin-top: 6px;
        }

        /* ===== KPI Strip ===== */
        .kpi-strip {
            background: #fff;
            border-bottom: 2px solid #e8ecf0;
            padding: 16px 40px;
            display: flex;
            flex-wrap: wrap;
            gap: 0;
            margin-bottom: 32px;
        }

        .kpi-item {
            flex: 1;
            min-width: 110px;
            text-align: center;
            padding: 8px 12px;
            border-right: 1px solid #e8ecf0;
        }

        .kpi-item:last-child { border-right: none; }

        .kpi-label {
            font-size: 0.72em;
            color: #7f8c8d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .kpi-value {
            font-size: 1.5em;
            font-weight: 700;
            font-family: 'Courier New', monospace;
        }

        .kpi-value.positive { color: #27ae60; }
        .kpi-value.negative { color: #e74c3c; }
        .kpi-value.neutral  { color: #2c3e50; }
        .kpi-value.grade    { color: #e67e22; }

        /* ===== Section Headers ===== */
        .section {
            margin-bottom: 48px;
        }

        .section-header {
            display: flex;
            align-items: center;
            padding: 12px 0 12px 16px;
            margin-bottom: 20px;
            border-left: 5px solid #3498db;
        }

        /* Per-section border colors */
        .section-1 .section-header { border-left-color: #3498db; }
        .section-2 .section-header { border-left-color: #9b59b6; }
        .section-3 .section-header { border-left-color: #1abc9c; }
        .section-4 .section-header { border-left-color: #2ecc71; }
        .section-5 .section-header { border-left-color: #e67e22; }
        .section-6 .section-header { border-left-color: #3498db; }
        .section-7 .section-header { border-left-color: #f39c12; }
        .section-8 .section-header { border-left-color: #e74c3c; }

        .section-number {
            font-size: 0.75em;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #95a5a6;
            margin-right: 12px;
            min-width: 28px;
        }

        .section-title-cn { font-size: 1.25em; font-weight: 700; margin-right: 10px; }
        .section-title-en { font-size: 0.9em; color: #7f8c8d; font-style: italic; }

        /* ===== Preprocessing Pipeline ===== */
        .pipeline {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0;
            background: #fff;
            border: 1px solid #dce3ea;
            border-radius: 8px;
            padding: 14px 20px;
            margin-bottom: 20px;
            font-size: 0.85em;
        }

        .pipeline-step {
            background: #eaf4fd;
            border: 1px solid #b3d4f0;
            border-radius: 20px;
            padding: 5px 14px;
            color: #1a5f96;
            white-space: nowrap;
        }

        .pipeline-arrow {
            color: #95a5a6;
            font-size: 1.1em;
            padding: 0 8px;
        }

        /* ===== Data Tables ===== */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border: 1px solid #dce3ea;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 20px;
            font-size: 0.88em;
        }

        .data-table thead tr {
            background: #f0f4f8;
            color: #4a5568;
        }

        .data-table th {
            padding: 10px 14px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid #dce3ea;
        }

        .data-table td {
            padding: 8px 14px;
            border-bottom: 1px solid #eef1f4;
            vertical-align: middle;
        }

        .data-table tbody tr:nth-child(even) { background: #f9fbfc; }
        .data-table tbody tr:last-child td { border-bottom: none; }
        .data-table tbody tr:hover { background: #f0f6ff; }

        .data-table td.num { text-align: right; font-family: 'Courier New', monospace; }
        .data-table td.positive { color: #27ae60; font-weight: 600; }
        .data-table td.negative { color: #e74c3c; font-weight: 600; }

        /* ===== Charts ===== */
        .chart-container {
            background: #fff;
            border: 1px solid #dce3ea;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 20px;
            overflow-x: auto;
        }

        .chart-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 20px;
        }

        .chart-unavailable {
            background: #f5f5f5;
            border: 1px dashed #ccc;
            border-radius: 6px;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #aaa;
            font-size: 0.85em;
        }

        /* ===== LLM Narrative Boxes ===== */
        .narrative-box {
            background: #f9fafb;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 16px;
            font-size: 0.9em;
            line-height: 1.8;
        }

        .narrative-box .llm-prefix {
            font-weight: 700;
            color: #4a5568;
            margin-bottom: 6px;
            font-size: 0.85em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .narrative-box p { margin-bottom: 8px; }
        .narrative-box p:last-child { margin-bottom: 0; }

        .missing-narrative {
            color: #bbb;
            font-style: italic;
            font-size: 0.85em;
        }

        /* ===== Attribution Cards (Section 2) ===== */
        .attribution-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 20px;
        }

        .attribution-card {
            border-radius: 8px;
            padding: 16px 18px;
            font-size: 0.88em;
            line-height: 1.7;
        }

        .attribution-card h3 {
            font-size: 0.9em;
            margin-bottom: 6px;
        }

        .attribution-card.behavioral { background: #eaf4fd; border: 1px solid #b3d4f0; }
        .attribution-card.fundamental { background: #fdf6e3; border: 1px solid #f0d9a0; }
        .attribution-card.microstructure { background: #eafaf1; border: 1px solid #a9dfbf; }
        .attribution-card.macro { background: #fef9e7; border: 1px solid #f9e79f; }

        /* ===== Annual Table Regime Badges ===== */
        .regime-badge {
            font-size: 1.0em;
            margin-right: 4px;
        }

        /* ===== Composite Scorecard (Section 7) ===== */
        .score-table-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .score-dim-table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            border: 1px solid #dce3ea;
            border-radius: 8px;
            overflow: hidden;
            font-size: 0.88em;
        }

        .score-dim-table th {
            background: #f0f4f8;
            padding: 9px 14px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid #dce3ea;
        }

        .score-dim-table td {
            padding: 8px 14px;
            border-bottom: 1px solid #eef1f4;
        }

        .score-dim-table tbody tr:last-child td { border-bottom: none; }

        .score-bar-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .score-bar {
            height: 8px;
            border-radius: 4px;
            background: #3498db;
            min-width: 2px;
        }

        .score-bar.high   { background: #27ae60; }
        .score-bar.medium { background: #f39c12; }
        .score-bar.low    { background: #e74c3c; }

        .composite-summary {
            background: linear-gradient(135deg, #1a2a4a, #2c3e6a);
            color: #fff;
            border-radius: 8px;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            gap: 24px;
            margin-bottom: 20px;
        }

        .composite-grade-large {
            font-size: 3.5em;
            font-weight: 900;
            color: #f39c12;
            line-height: 1;
        }

        .composite-score-num {
            font-size: 1.1em;
            color: #aab8d0;
        }

        /* ===== Critical Review (Section 8) ===== */
        .critical-review-section {
            background: #fff8f8;
            border: 1px solid #f5c6cb;
            border-radius: 10px;
            padding: 20px 24px;
            margin-bottom: 20px;
        }

        .weakness-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 20px;
        }

        .weakness-card {
            background: #fff;
            border-left: 4px solid #e74c3c;
            border-radius: 4px;
            padding: 14px 16px;
            font-size: 0.88em;
            line-height: 1.7;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        }

        .weakness-card h3 {
            color: #c0392b;
            font-size: 0.92em;
            margin-bottom: 6px;
        }

        .improvement-box {
            background: #eafaf1;
            border: 1px solid #a9dfbf;
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 20px;
        }

        .improvement-box h3 {
            color: #1e8449;
            font-size: 0.95em;
            margin-bottom: 10px;
        }

        .improvement-box ul {
            padding-left: 20px;
        }

        .improvement-box ul li {
            margin-bottom: 6px;
            font-size: 0.88em;
            line-height: 1.7;
        }

        /* ===== Footer ===== */
        .report-footer {
            background: #f0f4f8;
            border-top: 1px solid #dce3ea;
            text-align: center;
            padding: 20px 24px;
            font-size: 0.78em;
            color: #95a5a6;
            margin-top: 40px;
        }

        /* ===== Utilities ===== */
        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .text-right { text-align: right; }
        .text-center { text-align: center; }

        @media (max-width: 768px) {
            .chart-grid-2, .attribution-grid, .weakness-grid, .score-table-container, .two-col {
                grid-template-columns: 1fr;
            }
            .kpi-strip { padding: 12px 16px; }
            .report-header { padding: 24px 20px 18px; }
            .container { padding: 0 12px 32px; }
        }
    </style>
</head>
<body>

<!-- ===== Report Header ===== -->
<div class="report-header">
    <div class="factor-label">Factor Analysis Report / 因子分析报告</div>
    <h1>
        {% if narrative and narrative.factor_metadata and narrative.factor_metadata.name_cn %}
            {{ narrative.factor_metadata.name_cn }}
        {% else %}
            {{ factor.name }}
        {% endif %}
    </h1>
    <div class="factor-name-en">{{ factor.name }}</div>

    <div class="factor-meta-row">
        <span><strong>ID:</strong> factor_{{ factor.id }}</span>
        <span><strong>类别:</strong> {{ factor.category }}</span>
        <span><strong>批次:</strong> {{ factor.batch }}</span>
        {% if factor.admitted_at %}<span><strong>入库时间:</strong> {{ factor.admitted_at }}</span>{% endif %}
        <span><strong>生成时间:</strong> {{ generated_at }}</span>
    </div>

    <div class="formula-box">
        {% if narrative and narrative.factor_metadata and narrative.factor_metadata.expression_latex %}
            $${{ narrative.factor_metadata.expression_latex }}$$
        {% endif %}
        <div class="formula-raw">Qlib Expression: <code>{{ factor.expression }}</code></div>
    </div>
</div>

<!-- ===== KPI Strip ===== -->
<div class="kpi-strip">
    <div class="kpi-item">
        <div class="kpi-label">IC Mean (IS)</div>
        <div class="kpi-value {% if kpi.ic_mean_is > 0 %}positive{% elif kpi.ic_mean_is < 0 %}negative{% else %}neutral{% endif %}">
            {{ "%.4f" | format(kpi.ic_mean_is) }}
        </div>
    </div>
    <div class="kpi-item">
        <div class="kpi-label">IC Mean (OOS)</div>
        <div class="kpi-value {% if kpi.ic_mean_oos > 0 %}positive{% elif kpi.ic_mean_oos < 0 %}negative{% else %}neutral{% endif %}">
            {{ "%.4f" | format(kpi.ic_mean_oos) }}
        </div>
    </div>
    <div class="kpi-item">
        <div class="kpi-label">IC IR</div>
        <div class="kpi-value {% if kpi.ic_ir > 0.3 %}positive{% elif kpi.ic_ir < 0 %}negative{% else %}neutral{% endif %}">
            {{ "%.3f" | format(kpi.ic_ir) }}
        </div>
    </div>
    <div class="kpi-item">
        <div class="kpi-label">Win Rate</div>
        <div class="kpi-value {% if kpi.ic_win_rate > 0.5 %}positive{% elif kpi.ic_win_rate < 0.5 %}negative{% else %}neutral{% endif %}">
            {{ "%.1f" | format(kpi.ic_win_rate * 100) }}%
        </div>
    </div>
    <div class="kpi-item">
        <div class="kpi-label">Monotonicity</div>
        <div class="kpi-value {% if kpi.monotonicity | abs > 0.6 %}positive{% elif kpi.monotonicity | abs < 0.3 %}negative{% else %}neutral{% endif %}">
            {{ "%.3f" | format(kpi.monotonicity) }}
        </div>
    </div>
    <div class="kpi-item">
        <div class="kpi-label">L/S Return</div>
        <div class="kpi-value {% if kpi.ls_return > 0 %}positive{% elif kpi.ls_return < 0 %}negative{% else %}neutral{% endif %}">
            {{ "%.2f" | format(kpi.ls_return * 100) }}%
        </div>
    </div>
    <div class="kpi-item">
        <div class="kpi-label">综合评级</div>
        <div class="kpi-value grade">{{ kpi.composite_grade }}</div>
    </div>
</div>

<div class="container">

<!-- ===== Section 1: Construction Logic ===== -->
<div class="section section-1">
    <div class="section-header">
        <span class="section-number">01</span>
        <span class="section-title-cn">因子构建逻辑</span>
        <span class="section-title-en">Construction Logic</span>
    </div>

    {% if narrative and narrative.construction_logic %}
    <div class="narrative-box">
        <div class="llm-prefix">LLM 解读:</div>
        {% if narrative.construction_logic.formula_decomposition %}
            <p><strong>公式分解：</strong>{{ narrative.construction_logic.formula_decomposition }}</p>
        {% endif %}
        {% if narrative.construction_logic.data_inputs %}
            <p><strong>数据输入：</strong>{{ narrative.construction_logic.data_inputs }}</p>
        {% endif %}
        {% if narrative.construction_logic.computation_steps %}
            <p><strong>计算步骤：</strong>{{ narrative.construction_logic.computation_steps }}</p>
        {% endif %}
        {% if narrative.construction_logic.parameter_sensitivity %}
            <p><strong>参数敏感性：</strong>{{ narrative.construction_logic.parameter_sensitivity }}</p>
        {% endif %}
    </div>
    {% else %}
    <p class="missing-narrative">Narrative not generated</p>
    {% endif %}

    <!-- Preprocessing Pipeline -->
    {% if preprocessing %}
    <div class="pipeline">
        <span class="pipeline-step">Raw Factor</span>
        <span class="pipeline-arrow">→</span>
        {% if preprocessing.filter_suspend %}
        <span class="pipeline-step">Filter Suspended</span>
        <span class="pipeline-arrow">→</span>
        {% endif %}
        {% if preprocessing.filter_limit %}
        <span class="pipeline-step">Filter Limit-Up/Down</span>
        <span class="pipeline-arrow">→</span>
        {% endif %}
        <span class="pipeline-step">Winsorize ({{ preprocessing.winsorize_method }} {{ preprocessing.winsorize_n }}σ)</span>
        <span class="pipeline-arrow">→</span>
        <span class="pipeline-step">{{ preprocessing.standardize_method }}</span>
        {% if preprocessing.neutralize_mode and preprocessing.neutralize_mode != 'none' %}
        <span class="pipeline-arrow">→</span>
        <span class="pipeline-step">Neutralize ({{ preprocessing.neutralize_mode }})</span>
        {% endif %}
        <span class="pipeline-arrow">→</span>
        <span class="pipeline-step">Clean Factor</span>
    </div>
    {% endif %}
</div>

<!-- ===== Section 2: Economic Interpretation ===== -->
<div class="section section-2">
    <div class="section-header">
        <span class="section-number">02</span>
        <span class="section-title-cn">经济学解释</span>
        <span class="section-title-en">Economic Interpretation</span>
    </div>

    {% if narrative and narrative.economic_interpretation %}
    <div class="narrative-box">
        <div class="llm-prefix">LLM 解读:</div>
        {% if narrative.economic_interpretation.main_hypothesis %}
            <p><strong>核心假设：</strong>{{ narrative.economic_interpretation.main_hypothesis }}</p>
        {% endif %}
        {% if narrative.economic_interpretation.market_mechanism %}
            <p><strong>市场机制：</strong>{{ narrative.economic_interpretation.market_mechanism }}</p>
        {% endif %}
        {% if narrative.economic_interpretation.expected_conditions %}
            <p><strong>适用条件：</strong>{{ narrative.economic_interpretation.expected_conditions }}</p>
        {% endif %}
    </div>

    {% if narrative.economic_interpretation.attribution_angles %}
    <div class="attribution-grid">
        {% for angle in narrative.economic_interpretation.attribution_angles %}
        <div class="attribution-card {{ ['behavioral','fundamental','microstructure','macro'][loop.index0 % 4] }}">
            <h3>{{ angle.title }}</h3>
            <p>{{ angle.description }}</p>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {% else %}
    <p class="missing-narrative">Narrative not generated</p>
    {% endif %}
</div>

<!-- ===== Section 3: Factor Distribution ===== -->
<div class="section section-3">
    <div class="section-header">
        <span class="section-number">03</span>
        <span class="section-title-cn">因子分布分析</span>
        <span class="section-title-en">Factor Distribution</span>
    </div>

    <!-- Distribution Stats Table -->
    {% if distribution and (distribution.stats_is or distribution.stats_oos) %}
    <table class="data-table">
        <thead>
            <tr>
                <th>统计指标</th>
                <th>样本内 (IS)</th>
                {% if distribution.stats_oos %}<th>样本外 (OOS)</th><th>Delta</th>{% endif %}
            </tr>
        </thead>
        <tbody>
            {% set stats_is = distribution.stats_is or {} %}
            {% set stats_oos = distribution.stats_oos or {} %}
            {% macro delta_pct(is_val, oos_val) %}{% if is_val and oos_val and is_val != 0 %}{% set d = ((oos_val - is_val) / is_val * 100) %}{% if d > 0 %}<span class="positive">+{{ "%.1f" | format(d) }}%</span>{% else %}<span class="negative">{{ "%.1f" | format(d) }}%</span>{% endif %}{% else %}—{% endif %}{% endmacro %}
            <tr>
                <td>均值 (Mean)</td>
                <td class="num">{{ "%.6f" | format(stats_is.mean or 0) }}</td>
                {% if distribution.stats_oos %}<td class="num">{{ "%.6f" | format(stats_oos.mean or 0) }}</td><td class="num">{{ delta_pct(stats_is.mean, stats_oos.mean) }}</td>{% endif %}
            </tr>
            <tr>
                <td>标准差 (Std)</td>
                <td class="num">{{ "%.6f" | format(stats_is.std or 0) }}</td>
                {% if distribution.stats_oos %}<td class="num">{{ "%.6f" | format(stats_oos.std or 0) }}</td><td class="num">{{ delta_pct(stats_is.std, stats_oos.std) }}</td>{% endif %}
            </tr>
            <tr>
                <td>偏度 (Skewness)</td>
                <td class="num {% if (stats_is.skewness or 0) | abs > 1 %}negative{% endif %}">{{ "%.4f" | format(stats_is.skewness or 0) }}</td>
                {% if distribution.stats_oos %}<td class="num {% if (stats_oos.skewness or 0) | abs > 1 %}negative{% endif %}">{{ "%.4f" | format(stats_oos.skewness or 0) }}</td><td class="num">—</td>{% endif %}
            </tr>
            <tr>
                <td>峰度 (Kurtosis)</td>
                <td class="num">{{ "%.4f" | format(stats_is.kurtosis or 0) }}</td>
                {% if distribution.stats_oos %}<td class="num">{{ "%.4f" | format(stats_oos.kurtosis or 0) }}</td><td class="num">—</td>{% endif %}
            </tr>
            <tr>
                <td>覆盖率 (Coverage)</td>
                <td class="num {% if (stats_is.coverage or 0) > 0.9 %}positive{% elif (stats_is.coverage or 0) < 0.7 %}negative{% endif %}">{{ "%.2f" | format((stats_is.coverage or 0) * 100) }}%</td>
                {% if distribution.stats_oos %}<td class="num {% if (stats_oos.coverage or 0) > 0.9 %}positive{% elif (stats_oos.coverage or 0) < 0.7 %}negative{% endif %}">{{ "%.2f" | format((stats_oos.coverage or 0) * 100) }}%</td><td class="num">{{ delta_pct(stats_is.coverage, stats_oos.coverage) }}</td>{% endif %}
            </tr>
            <tr>
                <td>缺失率 (NaN Ratio)</td>
                <td class="num {% if (stats_is.nan_ratio or 0) > 0.2 %}negative{% endif %}">{{ "%.2f" | format((stats_is.nan_ratio or 0) * 100) }}%</td>
                {% if distribution.stats_oos %}<td class="num {% if (stats_oos.nan_ratio or 0) > 0.2 %}negative{% endif %}">{{ "%.2f" | format((stats_oos.nan_ratio or 0) * 100) }}%</td><td class="num">{{ delta_pct(stats_is.nan_ratio, stats_oos.nan_ratio) }}</td>{% endif %}
            </tr>
        </tbody>
    </table>
    {% endif %}

    <!-- Distribution Charts -->
    <div class="chart-grid-2">
        <div class="chart-container">
            {% if distribution and distribution.charts and distribution.charts.distribution_overlay %}
                {{ distribution.charts.distribution_overlay | safe }}
            {% else %}
                <div class="chart-unavailable">Chart unavailable</div>
            {% endif %}
        </div>
        <div class="chart-container">
            {% if distribution and distribution.charts and distribution.charts.coverage_timeseries %}
                {{ distribution.charts.coverage_timeseries | safe }}
            {% else %}
                <div class="chart-unavailable">Chart unavailable</div>
            {% endif %}
        </div>
    </div>

    <!-- Narrative -->
    {% if narrative and narrative.section_interpretations and narrative.section_interpretations.distribution %}
    <div class="narrative-box">
        <div class="llm-prefix">LLM 解读:</div>
        <p>{{ narrative.section_interpretations.distribution }}</p>
    </div>
    {% endif %}
</div>

<!-- ===== Section 4: IC Analysis ===== -->
<div class="section section-4">
    <div class="section-header">
        <span class="section-number">04</span>
        <span class="section-title-cn">IC 分析</span>
        <span class="section-title-en">IC Analysis</span>
    </div>

    <!-- IC Summary Table -->
    {% if ic_analysis and ic_analysis.summary %}
    <table class="data-table">
        <thead>
            <tr>
                <th>IC 指标</th>
                <th>样本内 (IS)</th>
                <th>样本外 (OOS)</th>
            </tr>
        </thead>
        <tbody>
            {% set s_is = ic_analysis.summary.is or {} %}
            {% set s_oos = ic_analysis.summary.oos or {} %}
            <tr>
                <td>IC 均值 (IC Mean)</td>
                <td class="num {% if (s_is.ic_mean or 0) > 0 %}positive{% elif (s_is.ic_mean or 0) < 0 %}negative{% endif %}">{{ "%.6f" | format(s_is.ic_mean or 0) }}</td>
                <td class="num {% if (s_oos.ic_mean or 0) > 0 %}positive{% elif (s_oos.ic_mean or 0) < 0 %}negative{% endif %}">{{ "%.6f" | format(s_oos.ic_mean or 0) }}</td>
            </tr>
            <tr>
                <td>IC 标准差 (IC Std)</td>
                <td class="num">{{ "%.6f" | format(s_is.ic_std or 0) }}</td>
                <td class="num">{{ "%.6f" | format(s_oos.ic_std or 0) }}</td>
            </tr>
            <tr>
                <td>IC IR</td>
                <td class="num {% if (s_is.ic_ir or 0) > 0.3 %}positive{% elif (s_is.ic_ir or 0) < 0 %}negative{% endif %}">{{ "%.4f" | format(s_is.ic_ir or 0) }}</td>
                <td class="num {% if (s_oos.ic_ir or 0) > 0.3 %}positive{% elif (s_oos.ic_ir or 0) < 0 %}negative{% endif %}">{{ "%.4f" | format(s_oos.ic_ir or 0) }}</td>
            </tr>
            <tr>
                <td>胜率 (Win Rate)</td>
                <td class="num {% if (s_is.win_rate or 0) > 0.5 %}positive{% elif (s_is.win_rate or 0) < 0.5 %}negative{% endif %}">{{ "%.2f" | format((s_is.win_rate or 0) * 100) }}%</td>
                <td class="num {% if (s_oos.win_rate or 0) > 0.5 %}positive{% elif (s_oos.win_rate or 0) < 0.5 %}negative{% endif %}">{{ "%.2f" | format((s_oos.win_rate or 0) * 100) }}%</td>
            </tr>
            <tr>
                <td>显著率 (|IC|>0.02)</td>
                <td class="num">{{ "%.2f" | format((s_is.ic_significant_rate or 0) * 100) }}%</td>
                <td class="num">{{ "%.2f" | format((s_oos.ic_significant_rate or 0) * 100) }}%</td>
            </tr>
            <tr>
                <td>样本天数 (N Days)</td>
                <td class="num">{{ s_is.n_days or 0 }}</td>
                <td class="num">{{ s_oos.n_days or 0 }}</td>
            </tr>
        </tbody>
    </table>
    {% endif %}

    <!-- IC Charts Row 1 -->
    <div class="chart-container">
        {% if ic_analysis and ic_analysis.charts and ic_analysis.charts.ic_timeseries %}
            {{ ic_analysis.charts.ic_timeseries | safe }}
        {% else %}
            <div class="chart-unavailable">IC Timeseries chart unavailable</div>
        {% endif %}
    </div>

    <div class="chart-grid-2">
        <div class="chart-container">
            {% if ic_analysis and ic_analysis.charts and ic_analysis.charts.rolling_ic %}
                {{ ic_analysis.charts.rolling_ic | safe }}
            {% else %}
                <div class="chart-unavailable">Rolling IC chart unavailable</div>
            {% endif %}
        </div>
        <div class="chart-container">
            {% if ic_analysis and ic_analysis.charts and ic_analysis.charts.ic_distribution %}
                {{ ic_analysis.charts.ic_distribution | safe }}
            {% else %}
                <div class="chart-unavailable">IC Distribution chart unavailable</div>
            {% endif %}
        </div>
    </div>

    <div class="chart-grid-2">
        <div class="chart-container">
            {% if ic_analysis and ic_analysis.charts and ic_analysis.charts.cumulative_ic %}
                {{ ic_analysis.charts.cumulative_ic | safe }}
            {% else %}
                <div class="chart-unavailable">Cumulative IC chart unavailable</div>
            {% endif %}
        </div>
        <div class="chart-container">
            {% if ic_analysis and ic_analysis.charts and ic_analysis.charts.monthly_heatmap %}
                {{ ic_analysis.charts.monthly_heatmap | safe }}
            {% else %}
                <div class="chart-unavailable">Monthly Heatmap chart unavailable</div>
            {% endif %}
        </div>
    </div>

    <!-- Annual Breakdown Table -->
    {% if ic_analysis and ic_analysis.annual and ic_analysis.annual | length > 0 %}
    <h3 style="margin-bottom: 10px; color: #4a5568; font-size: 0.95em;">逐年 IC 分析</h3>
    <table class="data-table">
        <thead>
            <tr>
                <th>年份</th>
                <th>市场环境</th>
                <th>IC 均值</th>
                <th>IC IR</th>
                <th>胜率</th>
            </tr>
        </thead>
        <tbody>
            {% for row in ic_analysis.annual %}
            <tr>
                <td>{{ row.year }}</td>
                <td>
                    {% if row.regime == 'bull' %}
                        <span class="regime-badge">🐂</span> 牛市
                    {% elif row.regime == 'bear' %}
                        <span class="regime-badge">🐻</span> 熊市
                    {% else %}
                        <span class="regime-badge">📊</span> 震荡
                    {% endif %}
                </td>
                <td class="num {% if (row.ic_mean or 0) > 0 %}positive{% elif (row.ic_mean or 0) < 0 %}negative{% endif %}">{{ "%.4f" | format(row.ic_mean or 0) }}</td>
                <td class="num {% if (row.ic_ir or 0) > 0.3 %}positive{% elif (row.ic_ir or 0) < 0 %}negative{% endif %}">{{ "%.4f" | format(row.ic_ir or 0) }}</td>
                <td class="num {% if (row.win_rate or 0) > 0.5 %}positive{% elif (row.win_rate or 0) < 0.5 %}negative{% endif %}">{{ "%.2f" | format((row.win_rate or 0) * 100) }}%</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    <!-- Narrative -->
    {% if narrative and narrative.section_interpretations and narrative.section_interpretations.ic_analysis %}
    <div class="narrative-box">
        <div class="llm-prefix">LLM 解读:</div>
        <p>{{ narrative.section_interpretations.ic_analysis }}</p>
    </div>
    {% endif %}
</div>

<!-- ===== Section 5: Quintile Analysis ===== -->
<div class="section section-5">
    <div class="section-header">
        <span class="section-number">05</span>
        <span class="section-title-cn">分组收益分析</span>
        <span class="section-title-en">Quintile Analysis</span>
    </div>

    <!-- Quintile Charts -->
    <div class="chart-grid-2">
        <div class="chart-container">
            {% if quintile and quintile.charts and quintile.charts.quintile_bar %}
                {{ quintile.charts.quintile_bar | safe }}
            {% else %}
                <div class="chart-unavailable">Quintile bar chart unavailable</div>
            {% endif %}
        </div>
        <div class="chart-container">
            {% if quintile and quintile.charts and quintile.charts.cumulative_returns %}
                {{ quintile.charts.cumulative_returns | safe }}
            {% else %}
                <div class="chart-unavailable">Cumulative returns chart unavailable</div>
            {% endif %}
        </div>
    </div>

    <div class="chart-grid-2">
        <div class="chart-container">
            {% if quintile and quintile.charts and quintile.charts.long_short_curve %}
                {{ quintile.charts.long_short_curve | safe }}
            {% else %}
                <div class="chart-unavailable">Long-short curve chart unavailable</div>
            {% endif %}
        </div>
        <div class="chart-container">
            {% if quintile and quintile.charts and quintile.charts.is_vs_oos_bar %}
                {{ quintile.charts.is_vs_oos_bar | safe }}
            {% else %}
                <div class="chart-unavailable">IS vs OOS bar chart unavailable</div>
            {% endif %}
        </div>
    </div>

    <!-- Quintile Stats Table -->
    {% if quintile and quintile.stats and quintile.stats | length > 0 %}
    <table class="data-table">
        <thead>
            <tr>
                <th>分组</th>
                <th>年化收益</th>
                <th>年化波动</th>
                <th>Sharpe</th>
                <th>最大回撤</th>
                <th>Calmar</th>
                <th>胜天率</th>
            </tr>
        </thead>
        <tbody>
            {% for q in quintile.stats %}
            <tr>
                <td><strong>{{ q.quintile }}</strong></td>
                <td class="num {% if (q.ann_return or 0) > 0 %}positive{% elif (q.ann_return or 0) < 0 %}negative{% endif %}">{{ "%.2f" | format((q.ann_return or 0) * 100) }}%</td>
                <td class="num">{{ "%.2f" | format((q.ann_vol or 0) * 100) }}%</td>
                <td class="num {% if (q.sharpe or 0) > 1.0 %}positive{% elif (q.sharpe or 0) < 0 %}negative{% endif %}">{{ "%.3f" | format(q.sharpe or 0) }}</td>
                <td class="num negative">{{ "%.2f" | format((q.max_dd or 0) * 100) }}%</td>
                <td class="num {% if (q.calmar or 0) > 1.0 %}positive{% elif (q.calmar or 0) < 0 %}negative{% endif %}">{{ "%.3f" | format(q.calmar or 0) }}</td>
                <td class="num">{{ "%.2f" | format((q.win_days or 0) * 100) }}%</td>
            </tr>
            {% endfor %}
            {% if quintile.ls_stats and quintile.ls_stats | length > 0 %}
            <tr style="background: #f0f6ff; font-weight: 600;">
                <td>L/S (Q1-Q5)</td>
                <td class="num {% if (quintile.ls_stats.ann_return or 0) > 0 %}positive{% elif (quintile.ls_stats.ann_return or 0) < 0 %}negative{% endif %}">{{ "%.2f" | format((quintile.ls_stats.ann_return or 0) * 100) }}%</td>
                <td class="num">{{ "%.2f" | format((quintile.ls_stats.ann_vol or 0) * 100) }}%</td>
                <td class="num {% if (quintile.ls_stats.sharpe or 0) > 1.0 %}positive{% elif (quintile.ls_stats.sharpe or 0) < 0 %}negative{% endif %}">{{ "%.3f" | format(quintile.ls_stats.sharpe or 0) }}</td>
                <td class="num negative">{{ "%.2f" | format((quintile.ls_stats.max_dd or 0) * 100) }}%</td>
                <td class="num {% if (quintile.ls_stats.calmar or 0) > 1.0 %}positive{% elif (quintile.ls_stats.calmar or 0) < 0 %}negative{% endif %}">{{ "%.3f" | format(quintile.ls_stats.calmar or 0) }}</td>
                <td class="num">{{ "%.2f" | format((quintile.ls_stats.win_days or 0) * 100) }}%</td>
            </tr>
            {% endif %}
        </tbody>
    </table>
    {% endif %}

    <!-- Narrative -->
    {% if narrative and narrative.section_interpretations and narrative.section_interpretations.quintile %}
    <div class="narrative-box">
        <div class="llm-prefix">LLM 解读:</div>
        <p>{{ narrative.section_interpretations.quintile }}</p>
    </div>
    {% endif %}
</div>

<!-- ===== Section 6: Decay & Persistence ===== -->
<div class="section section-6">
    <div class="section-header">
        <span class="section-number">06</span>
        <span class="section-title-cn">衰减与持续性分析</span>
        <span class="section-title-en">Decay &amp; Persistence</span>
    </div>

    <!-- Decay Charts -->
    <div class="chart-grid-2">
        <div class="chart-container">
            {% if decay and decay.charts and decay.charts.ic_decay_bar %}
                {{ decay.charts.ic_decay_bar | safe }}
            {% else %}
                <div class="chart-unavailable">IC Decay bar chart unavailable</div>
            {% endif %}
        </div>
        <div class="chart-container">
            {% if decay and decay.charts and decay.charts.autocorrelation %}
                {{ decay.charts.autocorrelation | safe }}
            {% else %}
                <div class="chart-unavailable">Autocorrelation chart unavailable</div>
            {% endif %}
        </div>
    </div>

    <!-- Decay Table -->
    {% if decay and decay.ic_by_period and decay.ic_by_period | length > 0 %}
    <div class="two-col">
        <div>
            <h3 style="margin-bottom: 10px; color: #4a5568; font-size: 0.95em;">IC 衰减表</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>预测期 (days)</th>
                        <th>IC 均值</th>
                        <th>相对比率</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in decay.ic_by_period %}
                    <tr>
                        <td>{{ row.period }}d</td>
                        <td class="num {% if (row.ic or 0) > 0 %}positive{% elif (row.ic or 0) < 0 %}negative{% endif %}">{{ "%.6f" | format(row.ic or 0) }}</td>
                        <td class="num">{{ "%.2f" | format((row.ratio or 0) * 100) }}%</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% if decay.half_life_days %}
            <p style="font-size:0.85em; color:#7f8c8d; margin-top:8px;">
                估计半衰期: <strong>{{ decay.half_life_days }} 天</strong>
            </p>
            {% endif %}
        </div>

        <div>
            {% if decay.autocorrelation and decay.autocorrelation | length > 0 %}
            <h3 style="margin-bottom: 10px; color: #4a5568; font-size: 0.95em;">因子自相关</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>滞后期 (lag)</th>
                        <th>Spearman 相关</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in decay.autocorrelation %}
                    <tr>
                        <td>{{ row.lag }}d</td>
                        <td class="num {% if (row.corr or 0) | abs > 0.5 %}positive{% endif %}">{{ "%.4f" | format(row.corr or 0) }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>
    </div>
    {% endif %}

    <!-- Narrative -->
    {% if narrative and narrative.section_interpretations and narrative.section_interpretations.decay %}
    <div class="narrative-box">
        <div class="llm-prefix">LLM 解读:</div>
        <p>{{ narrative.section_interpretations.decay }}</p>
    </div>
    {% endif %}
</div>

<!-- ===== Section 7: Composite Scorecard ===== -->
<div class="section section-7">
    <div class="section-header">
        <span class="section-number">07</span>
        <span class="section-title-cn">综合评分卡</span>
        <span class="section-title-en">Composite Scorecard</span>
    </div>

    <!-- Composite Summary Banner -->
    {% if scores and scores.composite %}
    <div class="composite-summary">
        <div class="composite-grade-large">{{ scores.composite.grade }}</div>
        <div>
            <div style="font-size:1.8em; font-weight:700; color:#fff;">{{ "%.1f" | format(scores.composite.score or 0) }} / 100</div>
            <div class="composite-score-num">综合评分 · Composite Score</div>
        </div>
    </div>
    {% endif %}

    <div class="score-table-container">
        <!-- Radar Chart -->
        <div class="chart-container" style="margin-bottom:0;">
            {% if scores and scores.charts and scores.charts.radar %}
                {{ scores.charts.radar | safe }}
            {% else %}
                <div class="chart-unavailable">Radar chart unavailable</div>
            {% endif %}
        </div>

        <!-- Score Dimension Table -->
        {% if scores and scores.dimensions and scores.dimensions | length > 0 %}
        <div>
            <table class="score-dim-table">
                <thead>
                    <tr>
                        <th>维度</th>
                        <th>得分</th>
                        <th>评级</th>
                    </tr>
                </thead>
                <tbody>
                    {% for dim in scores.dimensions %}
                    <tr>
                        <td>{{ dim.name }}</td>
                        <td>
                            <div class="score-bar-wrapper">
                                <div class="score-bar {% if (dim.score or 0) >= 70 %}high{% elif (dim.score or 0) >= 45 %}medium{% else %}low{% endif %}"
                                     style="width: {{ [(dim.score or 0) * 1.2, 100] | min }}px">
                                </div>
                                <span style="font-family:'Courier New',monospace; font-size:0.9em;">{{ "%.1f" | format(dim.score or 0) }}</span>
                            </div>
                        </td>
                        <td style="font-weight:600; color: {% if dim.grade in ['A','A-'] %}#27ae60{% elif dim.grade in ['B+','B','B-'] %}#f39c12{% else %}#e74c3c{% endif %};">
                            {{ dim.grade }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <!-- Narrative -->
    {% if narrative and narrative.section_interpretations and narrative.section_interpretations.scorecard %}
    <div class="narrative-box">
        <div class="llm-prefix">LLM 解读:</div>
        <p>{{ narrative.section_interpretations.scorecard }}</p>
    </div>
    {% endif %}
</div>

<!-- ===== Section 8: Critical Review ===== -->
<div class="section section-8">
    <div class="section-header">
        <span class="section-number">08</span>
        <span class="section-title-cn">批判性审查</span>
        <span class="section-title-en">Critical Review</span>
    </div>

    {% if narrative and narrative.critical_review %}
    <div class="critical-review-section">
        {% if narrative.critical_review.one_liner %}
        <div class="narrative-box" style="background:#fff8f8; border-color:#f5c6cb; margin-bottom:12px;">
            <div class="llm-prefix" style="color:#c0392b;">一句话总结:</div>
            <p><strong>{{ narrative.critical_review.one_liner }}</strong></p>
        </div>
        {% endif %}
        {% if narrative.critical_review.body %}
        <div class="narrative-box" style="background:#fff; border-color:#f5c6cb; margin-bottom:16px;">
            <div class="llm-prefix" style="color:#c0392b;">LLM 解读:</div>
            <p>{{ narrative.critical_review.body }}</p>
        </div>
        {% elif narrative.critical_review.overall_assessment %}
        <div class="narrative-box" style="background:#fff; border-color:#f5c6cb; margin-bottom:16px;">
            <div class="llm-prefix" style="color:#c0392b;">LLM 解读:</div>
            <p>{{ narrative.critical_review.overall_assessment }}</p>
        </div>
        {% endif %}

        <!-- Key Weaknesses Grid -->
        {% if narrative.critical_review.key_weaknesses and narrative.critical_review.key_weaknesses | length > 0 %}
        <h3 style="color:#c0392b; margin-bottom:12px; font-size:0.95em;">核心弱点 Key Weaknesses</h3>
        <div class="weakness-grid">
            {% for w in narrative.critical_review.key_weaknesses %}
            <div class="weakness-card">
                <h3>
                    {% if w.title %}{{ w.title }}{% else %}弱点 {{ loop.index }}{% endif %}
                </h3>
                <p>{% if w.description %}{{ w.description }}{% else %}{{ w }}{% endif %}</p>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <!-- Improvement Directions -->
    {% if narrative.critical_review.improvement_directions and narrative.critical_review.improvement_directions | length > 0 %}
    <div class="improvement-box">
        <h3>改进方向 Improvement Directions</h3>
        <ul>
            {% for item in narrative.critical_review.improvement_directions %}
            <li>
                {% if item is mapping and item.description %}{{ item.description }}{% else %}{{ item }}{% endif %}
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    {% else %}
    <p class="missing-narrative">Narrative not generated</p>
    {% endif %}
</div>

</div><!-- .container -->

<!-- ===== Footer ===== -->
<div class="report-footer">
    <p>
        Factor Report &mdash; <strong>{{ factor.name }}</strong> (factor_{{ factor.id }}) &mdash;
        Generated at {{ generated_at }}
    </p>
    <p style="margin-top:4px; color:#bbb;">
        Powered by Ralph Factor Mining System &middot; Quant Factor Library
    </p>
</div>

</body>
</html>
