# QuantFactor System 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=quant_data
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=your_password_here

# ==================== 米筐数据源 ====================
# 从米筐获取的 license 连接字符串
RQDATAC_CONF=tcp://license:YOUR_KEY@rqdatad-pro.ricequant.com:16011

# ==================== 日志配置 ====================
# LOG_LEVEL=INFO
# LOG_FILE=logs/quant_factor.log

# ==================== 缓存配置 ====================
# CACHE_DIR=./cache
# CACHE_MAX_SIZE_MB=1000
